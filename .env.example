DATABASE_URL=postgres://user:password@localhost:5432/cut
DATABASE_SSL=false
# Tests use their own database so they never touch your development data.
# Leave unset to use DATABASE_URL's database name + "_test" (cut -> cut_test).
# It is created and migrated automatically when you run `npm test`, and must be
# on this computer (localhost).
# TEST_DATABASE_URL=postgres://localhost:5432/cut_test
# JWT_SECRET must be at least 32 characters or the app refuses to start.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Number of proxy hops in front of the app whose X-Forwarded-For header we trust
# for the visitor's real IP (rate limiting). Set to 1 on Railway/most hosts.
# Leave unset locally (no proxy) so a spoofed X-Forwarded-For can't dodge limits.
# TRUSTED_PROXY=1

# Set to true ONLY for the automated test runner to turn off rate limiting so the
# suite isn't throttled. Never set this in dev, staging, or production.
# DISABLE_RATE_LIMIT=true

# Who can create an account (see apps/api/src/lib/signupMode.js).
# SIGNUP_INVITE_CODES: comma-separated signup invite codes, 8+ characters each.
#   When set, new accounts need one of these codes (invitation-only). Rotate a
#   code by editing this variable and redeploying. Not related to coach invites.
# SIGNUPS_OPEN: "true" lets anyone sign up, no code needed.
# In production with neither set, sign-up is CLOSED. Locally it is open.
# SIGNUP_INVITE_CODES=friends-2026,gym-buddies-1
# SIGNUPS_OPEN=false

# Optional switches (features sleep until these are set)
# ANTHROPIC_API_KEY=   # wakes the AI plan writer
# APP_URL=https://your-app.up.railway.app   # the app's own public address (used in payment and email links)
# --- Coach money and subscriptions (all asleep until set; see GO-LIVE.md) ---
# MONEY_PROVIDER=whop    # "whop" (default) or "paypal" (possible later fallback)
# WHOP_API_KEY=          # Whop company API key (keep secret)
# WHOP_WEBHOOK_SECRET=   # secret for the Whop webhook at {APP_URL}/api/billing/webhook
# WHOP_COMPANY_ID=       # your Whop company id
# WHOP_ENV=              # "live" for real money; anything else (or blank) = sandbox
# WHOP_STARTUP_FEE_PLAN_ID=   # Whop plan for the one-off $49 coach startup fee
# WHOP_AI_MONTHLY_PLAN_ID=    # Whop plan for the AI plan, $12.99 a month
# WHOP_AI_YEARLY_PLAN_ID=     # Whop plan for the AI plan, $89.99 a year
# PAYOUT_METHOD=         # "A" or "B" (see GO-LIVE.md); blank = coach payouts stay off
# RESEND_API_KEY=        # wakes password-reset emails
# EMAIL_FROM=            # the "from" address on emails, on your Resend domain
# PRIVACY_CONTACT_EMAIL=you@example.com   # contact address on the terms/privacy/refunds pages (defaults to naeljam@hotmail.com)
# SENTRY_DSN=          # wakes error tracking (dormant until set; then run `npm install` so @sentry/node is present)

# Progress photos (see apps/api/src/lib/photoStorage.js).
# In production, photos stay switched off until ALL FIVE S3_* settings are set.
# Copy them from the Railway Storage Bucket's settings. Files stay private: the
# app hands each one only to its owner (or their coach, if they shared it).
# S3_BUCKET=            # the bucket's name
# S3_ENDPOINT=          # the bucket's address (copy it from Railway)
# S3_ACCESS_KEY_ID=     # the bucket's access key
# S3_SECRET_ACCESS_KEY= # the bucket's secret key (never share or commit it)
# S3_REGION=            # the bucket's region (copy it from Railway)
# Locally (no S3_* settings) photos are saved in this folder instead.
# Default: apps/api/uploads (ignored by git). Not used in production.
# UPLOAD_DIR=./apps/api/uploads
